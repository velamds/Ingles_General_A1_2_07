{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "The New Roads Ahead"}, {"type": "unit_name", "content": "Either Today or Tomorrow "}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "A1.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information, involving apologies, thanks, suggestions and invitations in communicative situations."}, {"type": "secondary_1", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_2", "content": "Describes events that happened at work, using appropriate expressions and well-constructed simple past phrases."}, {"type": "secondary_3", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_4", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_5", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_6", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_7", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_8", "content": "Describes events that happened at work, using appropriate expressions and well-constructed simple past phrases."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Intonation and Prominence  "}, {"type": "describer", "content": "<span class=\"underline\">Intonation</span> <br><span class=\"strong\">Intonation: </span>The rise and fall of your tone of voice when you speak.  Wh- questions end in a falling tone. Yes/No questions end in a rising tone.<br>The meaning of what you say depends on the tone or pitch of your voice.  <br><br> <span class=\"underline\">Prominence</span> <br><span class=\"strong\">Prominence:</span>The emphasis you put on a word in a phrase or sentence to show that it is important.  It is usually the last content word in a short sentence.<br>A syllable can be made prominent using loudness, pitch and length.<br><br>In the examples, words with rising intonation have CAPITAL letters. Words with prominence have <span class=\"strong\">CAPITAL AND BOLD</span> letters."}, {"type": "example", "content": " Peter WALKED in the<span class=\"strong\"> DARK</span>.      "}, {"type": "example", "content": "Sally SAT in the LAST <span class=\"strong\">ROW</span>."}, {"type": "example", "content": "Some CREDit CARD <span class=\"strong\">COM</span>panies CHARGE an ANNual <span class=\"strong\">FEE</span>. "}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you plan to meet someone."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "reservation"}, {"type": "definition", "content": "a booking or an appointment"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  Shall I make a reservation at Mineo's?"}, {"type": "audio", "content": "engenn3le07ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Long time no see"}, {"type": "definition", "content": "An expression used when you meet someone you have not seen in a long time"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example:  Long time no see. What have you been up to?"}, {"type": "audio", "content": "engenn3le07ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to catch up"}, {"type": "definition", "content": "to meet someone to talk about their life"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: How about we meet up for pizza to catch up?"}, {"type": "audio", "content": "engenn3le07ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Hawaiian"}, {"type": "definition", "content": "a kind of pizza with pineapple and ham"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Is Hawaiian pizza still your favorite?"}, {"type": "audio", "content": "engenn3le07ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "either"}, {"type": "definition", "content": "introduces a choice between two things - either/or"}, {"type": "part_speech", "content": "(conjunction)"}, {"type": "example", "content": "Example: Are you free either today or tomorrow?"}, {"type": "audio", "content": "engenn3le07ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to make it"}, {"type": "definition", "content": "to be at a place"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Can you make it 7:00 p.m.?"}, {"type": "audio", "content": "engenn3le07ob04aud07"}]}, {"type": "background_image", "content": "engenn3le07ob04re1img01.png"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Make a list of five people you want to go to dinner with."}, {"type": "text", "content": "What questions do you want to ask them about their lives? Example: <span class=\"italic\">What do you like for dessert?</span> Use a word with the <span class=\"italic\">er</span> sound in each question like <span class=\"italic\">mother</span>, <span class=\"italic\">brother</span>, and <span class=\"italic\">spider</span>."}, {"type": "text", "content": "Use rising intonation if it is a yes/no question. Use falling intonation it is a <span class=\"italic\">Wh-</span> question."}, {"type": "text", "content": "Write the five questions."}, {"type": "text", "content": "Read each question aloud."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I make a list of people I want to have dinner with."}, {"type": "text", "content": "I ask questions about people's lives."}, {"type": "text", "content": "I write questions that use words with the <span class=\"italic\">er</span> sound."}]}], "labs": [{"stimuli": [{"_data": [], "id": 0, "type": "welcome", "contents": [{}], "template_override": 1}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn3le07ob04re2aud01", "coverimg": "engenn3le07ob04re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn3le07ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Hey Peter. <br>\n<span class=\"strong\">Peter</span>: Hi Sally. How are you?<br>\n<span class=\"strong\">Sally</span>: Great! Long time no see. What have you been up to?<br>\n<span class=\"strong\">Peter</span>: I've been busy at work.<br>\n<span class=\"strong\">Sally</span>: Oh ... internships are hard. There is so much to learn.<br>\n<span class=\"strong\">Peter</span>: Yes ... So many e-mails and reports.<br>", "id": 1, "time": "100", "image": "engenn3le07ob04re2img02.jpg"}, {"text": "<span class=\"strong\">Sally</span>: How about we meet up for pizza to catch up?<br>\n<span class=\"strong\">Peter</span>: When?<br>\n<span class=\"strong\">Sally</span>: Either today or tomorrow. Are you free?<br>\n<span class=\"strong\">Peter</span>: I'm going to a friend's birthday dinner tonight. Tomorrow?<br>\n<span class=\"strong\">Sally</span> : No problem. Shall I make a reservation at Mineo's? At 6:30?<br>\n<span class=\"strong\">Peter</span>: Can you make it 7:00 p.m.? I have to write a 1000 word report first.<br>", "id": 2, "time": "21000", "image": "engenn3le07ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Sure. I'll be there a little early. I'll order us some drinks and garlic bread. Is Hawaiian still your favorite?<br>\n<span class=\"strong\">Peter</span>: Absolutely! See ya tomorrow.<br>\n<span class=\"strong\">Sally</span>: Ciao.<br>", "id": 3, "time": "44500", "image": "engenn3le07ob04re2img01.jpg"}]}}]}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "type": "scholar", "exercises": [{"questions": [], "stimuli_ids": [0], "id": 0, "type": "WLC", "img_path": "", "_data": [{"type": "instructions", "contents": [{"type": "Learning Outcomes", "content": "I can say and use the controlled vowel sound <span class=\"italic\">er</span>."}, {"type": "Learning Outcomes", "content": "I can say simple statements."}, {"type": "Learning Outcomes", "content": "I can identify key information in a short audio."}, {"type": "Free Header Item", "content": "Where do you \u2018catch up' with friends? At the park? A restaurant?"}, {"type": "Free Header Item", "content": " Are you good at keeping in touch with your friends? Why or why not?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Welcome"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct", "attempt_feedback": [{"type": "text", "content": "You have 2 tries"}, {"type": "text", "content": "you have 1 attempt left"}], "incorrect_feedback": [{"type": "text", "content": "try again"}, {