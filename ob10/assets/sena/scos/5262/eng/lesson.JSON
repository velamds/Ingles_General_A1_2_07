test"}]}, {"type": "objectives", "contents": [{"content": " Accurately explain information about interests, hobbies, and preferences in communicative situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_1"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_2"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_3"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_4"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_5"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_6"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_7"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_8"}]}, {"content": "engenn3le07ob10re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Making and Accepting Invitations", "type": "heading"}, {"content": "You can make invitations in many ways.  You use modals like <span class=\"italic\">would</span> or <span class=\"italic\">should</span> to give offers and invitations. <br>Here are some casual ways of inviting someone to do something with you, and accepting an invitation.", "type": "describer"}, {"content": "<span class=\"strong\">Pam</span>: Would you like to see a movie tomorrow night?", "type": "example"}, {"content": "<span class=\"strong\">Sam</span>: Sure, why not!", "type": "example"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Making an Invitation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Accepting an Invitation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would you like to come to my place?<br>  <br>Do you want to go to a movie?<br>  <br>Why don't you join us at the restaurant?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sure, why not!<br>   <br>OK, sounds good!<br>  <br>I would love to.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "nephew", "type": "name"}, {"content": "the son of your brother or sister ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to get a birthday present for my nephew. ", "type": "example"}, {"content": "engenn3le07ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you talk about hobbies and interests.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to be due", "type": "name"}, {"content": "used to say something must be submitted at a certain time ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My assignment is due in a week.", "type": "example"}, {"content": "engenn3le07ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to be into", "type": "name"}, {"content": "used to say someone is very interested in something ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My brother's really into computers and music.", "type": "example"}, {"content": "engenn3le07ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "movie script", "type": "name"}, {"content": "the written form of a film", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He likes watching films and reading movie scripts.", "type": "example"}, {"content": "engenn3le07ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "movie poster ", "type": "name"}, {"content": "a large paper advertisement for a film", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If you know his favorite film, you could get him a movie poster.", "type": "example"}, {"content": "engenn3le07ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "interest ", "type": "name"}, {"content": "something you like, you are interested in ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: What are his hobbies or interests?", "type": "example"}, {"content": "engenn3le07ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "headphones", "type": "name"}, {"content": "equipment you wear in or on your ears to listen to music", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You might buy him a nice pair of headphones.", "type": "example"}, {"content": "engenn3le07ob10aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Talk to 10 people.", "type": "text"}, {"content": "Ask each person about their hobbies or interests.", "type": "text"}, {"content": " Count the answers.", "type": "text"}, {"content": "Design a graph, like a bar graph, to show the answers.", "type": "text"}, {"content": "Present your graph to a partner or the class.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I ask questions about hobbies.", "type": "text"}, {"content": "I ask questions about interests.", "type": "text"}, {"content": "I present the results to a partner or a group.", "type": "text"}]}], "type": "sena"}