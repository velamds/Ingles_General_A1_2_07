{"_data": [{"type": "metadata", "contents": [{"content": "The New Roads Ahead", "type": "lesson_name"}, {"content": "Surprise!", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "A1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately explain information about interests, hobbies, and preferences in communicative situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_1"}, {"content": "Writes simple but clear texts describing or reviewing places to visit in a region, using an appropriate range of vocabulary and grammatical structures.", "type": "secondary_2"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_3"}, {"content": "Writes simple but clear texts describing or reviewing places to visit in a region, using an appropriate range of vocabulary and grammatical structures.", "type": "secondary_4"}, {"content": "Writes simple but clear texts describing or reviewing places to visit in a region, using an appropriate range of vocabulary and grammatical structures.", "type": "secondary_5"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_6"}, {"content": "Writes simple but clear texts describing or reviewing places to visit in a region, using an appropriate range of vocabulary and grammatical structures.", "type": "secondary_7"}, {"content": "Writes simple but clear texts describing or reviewing places to visit in a region, using an appropriate range of vocabulary and grammatical structures.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Socializing", "type": "heading"}, {"content": "To ask about other people, you say: <span class=\"italic\">How is \u2026 ?</span> You use wh- questions to ask about people. </br>You use the Simple Present tense to talk about how people are or to give statements that are always true. </br>   <br>When you talk about other people, you want to say what the person does on a regular basis. You use the Present Continuous tense to do this.<br>   <br>The Present Continuous tense shows that an action is happening over a long period of time or on a regular basis.<br>  <br>To ask about a different person, you say: <span class=\"italic\">What about \u2026 ?</span> <br>", "type": "describer"}, {"content": "<span class=\"strong\">Peter</span>: How is Vanessa?<br> <span class=\"strong\">Sally</span>: Vanessa is planning her trip to Mexico.<br> <span class=\"strong\">Peter</span>: What about John?<br> <span class=\"strong\">Sally</span>: John is training for a soccer tournament.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "countdown", "type": "name"}, {"content": "the final moments before an event", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The countdown is on!", "type": "example"}, {"content": "engenn3le07ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when socializing.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "nephew", "type": "name"}, {"content": "the son of your brother or sister", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to get a birthday present for my nephew.", "type": "example"}, {"content": "engenn3le07ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "I would rather", "type": "name"}, {"content": "I would prefer", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I would rather sit here.", "type": "example"}, {"content": "engenn3le07ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to agree", "type": "name"}, {"content": "to have the same opinion", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I agree with Carol. We need to monitor our budget.", "type": "example"}, {"content": "engenn3le07ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "take a year off ", "type": "name"}, {"content": "stop studying or working for one year", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Vanessa's trip makes me want to take a year off and travel.", "type": "example"}, {"content": "engenn3le07ob11aud05", "type": "audio"}]}, {"content": "engenn3le07ob11re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "With a partner, discuss which countries or cities you visited.", "type": "text"}, {"content": "Discuss the places you visited in those countries or cities.", "type": "text"}, {"content": "Draw your route on a map.", "type": "text"}, {"content": "Explain what forms of transportation you used.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I discuss traveling with a partner.", "type": "text"}, {"content": "I report on details of past events.", "type": "text"}, {"content": "I describe transportation.", "type": "text"}]}], "labs": [{"stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn3le07ob11re2aud01", "coverimg": "engenn3le07ob11re2img01.jpg", "images": [{"image": "engenn3le07ob11re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn3le07ob11re2img01.jpg", "text": "<span class=\"strong\">Vanessa</span>:  This is a great surprise birthday party, guys!<br>\n<span class=\"strong\">John</span>: Thanks. So Sally, the countdown is on for your trip!<br>\n<span class=\"strong\">Sally</span>: Yes, I'm super excited!", "id": 1, "time": "100"}, {"image": "engenn3le07ob11re2img02.jpg", "text": "<span class=\"strong\">John</span>: Could you tell us where you're going?<br>\n<span class=\"strong\">Sally</span>: Absolutely! I'm going to Paris and Rome.<br>\n<span class=\"strong\">Vanessa</span>: My nephew went to Paris last year. He loved it.", "id": 2, "time": "13000"}, {"image": "engenn3le07ob11re2img01.jpg", "text": "<span class=\"strong\">John</span>: Can you send us e-mails?<br>\n<span class=\"strong\">Sally</span>:  If you don't mind, I would rather not.  You can read my blog every day.<br>\n<span class=\"strong\">Peter</span>: I would prefer to see the pictures.<br>\n<span class=\"strong\">Vanessa</span>:  I agree.", "id": 3, "time": "23000"}, {"image": "engenn3le07ob11re2img01.jpg", "text": "<span class=\"strong\">Sally</span>: You can see photos on my blog.<br>\n<span class=\"strong\">Vanessa</span>:  You're so lucky you can take a year off because you won the lottery.", "id": 4, "time": "34500"}, {"image": "engenn3le07ob11re2img03.jpg", "text": "<span class=\"strong\">Peter</span>: Sally, remember I gave you that lottery ticket?<br>\n<span class=\"strong\">Sally</span>: You're the best, Peter!<br>\n<span class=\"strong\">Peter</span>:  You could do something for me.", "id": 5, "time": "41000"}, {"image": "engenn3le07ob11re2img01.jpg", "text": "<span class=\"strong\">Sally</span>:  What's that, Peter?<br>\n<span class=\"strong\">Peter</span>: Well ... You might think about sharing the prize.<br>\n<span class=\"strong\">Sally</span>: What?<br>\n<span class=\"strong\">Peter</span>:  Oh, never mind.", "id": 6, "time": "48000"}]}}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "I can make suggestions.", "type": "Learning Outcomes"}, {"content": "I can make and respond to requests. ", "type": "Learning Outcomes"}, {"content": "I can say what I would want or prefer to do.", "type": "Learning Outcomes"}, {"content": "I can talk about things and actions.", "type": "Learning Outcomes"}, {"content": "When was your last party? What was it for?", "type": "Free Header Item"}, {"content": "When was your last trip? Where did you go?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}]}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Let's review!", "type": "free_type_text_area"}], "img_path": "", "questions": [], "type": "WLC", "id": 0, "stimuli_ids": [0]}, {"template_override": 1, "type": "STI", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"tool-tip\" id=\"tip_1_0\">Was</span> the birthday party a surprise? Let's find out!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Content", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missi